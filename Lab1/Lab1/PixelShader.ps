cbuffer LightBuffer : register(b2)
{
    int4 lightCount;
    float4 lightPos[10];
    float4 lightColor[10];
    float4 ambient;
};

struct PSIn
{
    float4 position : SV_Position;
    float4 worldPos : POSITION;
    float3 normal : NORMAL;
    float4 color : COLOR;
};

float3 CalculateColor(float3 objColor, float3 objNormal, float3 pos)
{
    float3 finalColor = ambient.rgb * objColor;
    for (int i = 0; i < lightCount.x; i++)
    {
        float3 lightDir = lightPos[i].xyz - pos;
        float lightDist = length(lightDir);
        lightDir /= lightDist;
        float atten = clamp(1.0 / (lightDist * lightDist), 0, 1);
        float NdotL = max(dot(objNormal, lightDir), 0);
        finalColor += objColor * NdotL * atten * lightColor[i].rgb * lightColor[i].a;
    }
    return finalColor;
}

float4 main(PSIn input) : SV_Target0
{
    float3 normal = normalize(input.normal);
    float3 color = CalculateColor(input.color.rgb, normal, input.worldPos.xyz);
    return float4(color, 1.0f);
}