Texture2D<float4> HDRTexture : register(t0);
SamplerState LinearSampler : register(s0);

cbuffer BloomCB : register(b1)
{
    float4 Params0; // x=threshold, y=texelSizeX, z=texelSizeY, w=unused
    float4 Params1; // x=dirX, y=dirY, z=unused, w=unused
};

static const float3 LuminanceWeights = float3(0.2126f, 0.7151f, 0.0722f);

float4 main(float4 position : SV_Position, float2 texcoord : TEXCOORD) : SV_Target
{
    float3 hdr = HDRTexture.Sample(LinearSampler, texcoord).rgb;
    float lum = dot(hdr, LuminanceWeights);
    float w = saturate((lum - Params0.x) / max(Params0.x, 1e-4f));
    return float4(hdr * w, 1.0f);
}

