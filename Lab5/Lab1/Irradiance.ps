// Шейдер для вычисления irradiance map из cubemap
TextureCube<float4> EnvCubemap : register(t0);
SamplerState LinearSampler : register(s0);

static const float PI = 3.14159265359;

// Вычисление приближённого интеграла по полусфере
float4 main(float4 svPos : SV_Position, float3 worldPos : POSITION) : SV_Target
{
    // worldPos - направление нормали для текущего пикселя irradiance map
    float3 normal = normalize(worldPos);

    // Построение касательного базиса (как в эталонном решении)
    float3 dir = abs(normal.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
    float3 tangent = normalize(cross(dir, normal));
    float3 binormal = cross(normal, tangent);

    // Интегрирование по полусфере методом Римана
    float4 irradiance = float4(0.0, 0.0, 0.0, 0.0);

    // Параметры дискретизации
    const int N1 = 200;
    const int N2 = 50;

    [loop]
    for (int i = 0; i < N1; ++i)
    {
        [loop]
        for (int j = 0; j < N2; ++j)
        {
            float phi = i * (2.0f * PI / N1);
            float theta = j * (PI / 2.0f / N2);

            // Преобразование в декартовы координаты в касательном пространстве
            float3 a = float3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));

            // Преобразование из касательного пространства в мировое
            float3 t_sample = a.x * tangent - a.y * binormal + a.z * normal;

            // Сэмплирование cubemap
            irradiance += EnvCubemap.Sample(LinearSampler, t_sample) * cos(theta) * sin(theta);
        }
    }

    // Нормализация
    irradiance = PI * irradiance / (N1 * N2);

    return irradiance;
}
