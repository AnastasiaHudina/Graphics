// Шейдер для конвертации equirectangular HDRI в cubemap
Texture2D<float4> EquirectMap : register(t0);
SamplerState LinearSampler : register(s0);

static const float PI = 3.14159265359;

// Вход: мировая позиция вершины 
float4 main(float4 svPos : SV_Position, float3 worldPos : POSITION) : SV_Target
{
    // worldPos - это направление от центра куба к текущему пикселю на грани
    float3 wPos = normalize(worldPos);

    // Преобразуем направление в UV-координаты equirectangular карты
    // Используем формулу из эталонного решения для правильной ориентации
    float2 t_sample = float2(
        1.0f - atan2(wPos.z, wPos.x) / (2.0f * PI),
        1.0f - (0.5f + asin(wPos.y) / PI)
    );

    // Сэмплируем HDRI
    float4 color = EquirectMap.Sample(LinearSampler, t_sample);

    return color;
}
